<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TSLAN — Overlay classement (classique)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --purple: #7a1f5c;
            --red: #c8272c;
            --orange: #e88a12;
            --grad: linear-gradient(90deg, var(--purple), var(--red) 55%, var(--orange));
            --panel: rgba(28, 10, 22, 0.82);
            --panel-2: rgba(46, 14, 22, 0.82);
            --text: #fbeee4;
            --muted: #d9b3ae;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { height: 100%; width: 100%; overflow: hidden; background: transparent; }

        /*
         * Le viewport OBS (Browser Source) correspond exactement à la taille
         * en pixels configurée dans OBS : on en fait un "container query
         * container" pour que tout le contenu (police, logos, espacements)
         * soit dimensionné en cqh/cqw = % de CETTE boîte précise, quelle que
         * soit sa taille ou son ratio. Rien n'est en vh/vw ni en valeur fixe.
         */
        body {
            container-type: size;
            container-name: overlay;
            color: var(--text);
            font-family: "Rajdhani", "Segoe UI", system-ui, sans-serif;
        }

        .board {
            height: 100cqh;
            width: 100cqw;
            padding: 1.6cqh 2cqw;
            display: flex;
            flex-direction: column;
            gap: 1.1cqh;
        }

        header {
            flex: 0 0 6.4cqh;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2.2cqw;
            background: var(--panel);
            border-radius: 1.1cqh;
            border-left: 0.5cqh solid var(--orange);
        }

        header span.title {
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
            font-size: min(3.1cqh, 9.5cqw);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        header small {
            flex-shrink: 0;
            color: var(--muted);
            font-weight: 600;
            font-size: min(1.7cqh, 3.4cqw);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        /* La liste occupe tout le reste ; chaque ligne = 1/8 exact de cet espace, sans plafond. */
        #list {
            list-style: none;
            flex: 1 1 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            gap: 1cqh;
        }

        .row {
            flex: 1 1 0;
            min-height: 0;
            display: grid;
            grid-template-columns: 8cqh 8cqh minmax(0, 1fr) auto;
            align-items: center;
