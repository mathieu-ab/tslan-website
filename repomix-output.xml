</head>
<body>
    <div class="board">
        <ol id="list"></ol>
    </div>

    <script src="/js/obs-common.js"></script>
    <script>
        const list = document.getElementById("list");

        OBSRanking.start((rows, state) => {
            OBSRanking.mount(list, rows, {
                create(row) {
                    const li = document.createElement("li");
                    li.className = "row";
                    li.innerHTML = `
                        <span class="rank"></span>
                        <span class="logo-slot"></span>
                        <div class="info"><div class="team"></div><div class="members"></div></div>
                        <div class="points"><span class="pts-value" data-value=""></span><small>PTS</small></div>`;
                    li.querySelector(".logo-slot").replaceWith(OBSRanking.makeLogo(row.team));
                    return li;
                },
                update(el, row, i) {
                    el.classList.remove("top-1", "top-2", "top-3");
                    if (i < 3) el.classList.add(`top-${i + 1}`);
                    el.querySelector(".rank").textContent = row.rank;
                    el.querySelector(".team").textContent = row.team;
                    el.querySelector(".members").textContent = row.players.join("  •  ");
                    OBSRanking.animateNumber(el.querySelector(".pts-value"), row.pointsValue, row.points);
                },
                enter(el) {
                    el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500 });
                },
            }, state);
        });
    </script>
</body>
</html>
