    --text: #e9eef7;
    --muted: #9cb2cf;
    --accent: #39d99f;
    --accent-soft: rgba(57, 217, 159, 0.12);
    --border: rgba(255, 255, 255, 0.08);
}

body {
    min-height: 100vh;
    background: transparent;
    color: var(--text);
    display: flex;
    flex-direction: column;
}

main#content {
    max-width: 1080px;
