    color: var(--muted);
    margin-bottom: 1.8rem;
}

.content-card {
    background: rgba(10, 16, 29, 0.95);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06);
}

.content-card + .content-card {
    margin-top: 1.5rem;
}

.content-card h1,
.content-card h2,
.content-card h3,
.content-card h4 {
    color: #ffffff;
    margin-top: 1.8rem;
    margin-bottom: 0.9rem;
}

.content-card p,
.content-card li {
    color: var(--muted);
    margin-bottom: 1rem;
    font-size: 1rem;
}

.content-card ul {
    margin: 1rem 0 1.2rem 1.35rem;
    list-style: disc inside;
}

.content-card code {
    display: inline-block;
    max-width: 100%;
    background: rgba(255, 255, 255, 0.086);
    color: #ebfff7;
    padding: 0.2rem 0.45rem;
    border-radius: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.hero-panel {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
}

.hero-panel > * {
    min-width: 0;
}

.hero-card {
    background: rgba(12, 16, 30, 0.589);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    padding: 2rem;
    backdrop-filter: blur(8px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32);
    max-width: 840px;
    margin: 0 auto;
}

.hero-card h1 {
    text-align: center;
    font-size: clamp(2.4rem, 7vw, 4.3rem);
    margin-bottom: 1rem;
    line-height: 1.05;
}

.hero-card p {
    color: var(--muted);
    font-size: 1.05rem;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
    justify-content: center;
    text-align: center;
}

.hero-buttons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 155px;
    padding: 0.95rem 1.2rem;
    border-radius: 14px;
    background: var(--accent);
    color: #071010;
    font-weight: 700;
    box-shadow: 0 12px 24px rgba(57, 217, 159, 0.22);
}

.hero-buttons a.secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
}

.hero-buttons a:hover {
    transform: translateY(-1px);
}

.hero-buttons a.ticket-button {
    --ticket-rotate-x: 0deg;
    --ticket-rotate-y: 0deg;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: min(100%, 560px);
    min-height: 76px;
    padding: 1.2rem 2rem;
    border: 2px solid #b8ffe5;
    border-radius: 18px;
    background: linear-gradient(135deg, #52edb2, #21c98e);
    color: #04130f;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 16px 34px rgba(57, 217, 159, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    animation: ticket-button-glow 3s ease-in-out infinite;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.25s ease;
}

.hero-buttons a.ticket-button::before {
    position: absolute;
    top: 0;
    left: -75%;
    z-index: -1;
    width: 45%;
    height: 100%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.65), transparent);
    content: "";
    transform: skewX(-20deg);
    transition: left 0.65s ease;
}

.hero-buttons a.ticket-button:hover,
.hero-buttons a.ticket-button:focus-visible {
    transform: perspective(550px) translateY(-4px) rotateX(var(--ticket-rotate-x)) rotateY(var(--ticket-rotate-y)) scale(1.03);
    filter: brightness(1.08);
    box-shadow: 0 20px 42px rgba(57, 217, 159, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.55);
}

.hero-buttons a.ticket-button:hover::before,
.hero-buttons a.ticket-button:focus-visible::before {
    left: 135%;
}

.hero-buttons a.ticket-button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
}

@keyframes ticket-button-glow {
    0%,
    100% {
        box-shadow: 0 16px 34px rgba(57, 217, 159, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }

    50% {
        box-shadow: 0 18px 40px rgba(57, 217, 159, 0.48), 0 0 18px rgba(57, 217, 159, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.45);
    }
}

@media (prefers-reduced-motion: reduce) {
    .hero-buttons a.ticket-button {
        animation: none;
        transition: none;
    }

    .hero-buttons a.ticket-button::before {
        transition: none;
    }
}

.video-background {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
}

.video-background video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(8px);
}

.video-background .overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.40);
}

footer {
    max-width: 1080px;
    width: min(100% - 2rem, 1080px);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
}

.footer-links a {
    color: var(--accent);
}

@media (max-width: 820px) {
    .nav-inner {
        flex-direction: column;
        align-items: stretch;
    }

    .nav-links {
        justify-content: center;
    }

    main {
        margin-top: 1.5rem;
    }
}

@media (max-width: 660px) {
    main {
        margin: 1.5rem auto 2rem;
    }

    .content-card {
        padding: 1.5rem;
        border-radius: 20px;
    }

    .hero-panel {
        gap: 1rem;
    }

    .hero-card {
        padding: 1.4rem 1rem;
        max-width: 100%;
    }

    .hero-card h1 {
        font-size: clamp(2.1rem, 8vw, 3.4rem);
    }

    .hero-buttons {
        justify-content: center;
    }

    footer {
        padding: 1rem 1rem;
    }
}

@media (max-width: 480px) {
    main {
        margin: 1rem auto 1.5rem;
    }

    .nav-inner {
        padding: 0.85rem 1rem;
    }

    .footer-links {
        gap: 0.5rem;
    }

    .hero-card {
        padding: 1.1rem 0.95rem;
    }

    .hero-card h1 {
        font-size: clamp(1.9rem, 10vw, 3rem);
    }

    .page-intro,
    .hero-card p {
        font-size: 0.98rem;
    }
}

.copy-address {
    cursor: pointer;
    color: var(--accent);
    border-bottom: 1px dashed var(--accent);
    position: relative;
    transition: color 0.2s ease;
}

.copy-address:hover,
.copy-address:focus-visible {
    color: #80eac9;
}

.cursor-tooltip {
    position: fixed;
    top: 0;
    left: 0;
    background: var(--surface-strong);
    color: var(--text);
    font-size: 0.75rem;
    padding: 0.35rem 0.6rem;
    border-radius: 8px;
    white-space: nowrap;
    border: 1px solid var(--border);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -130%);
    transition: opacity 0.15s ease;
    z-index: 60;
}

.cursor-tooltip.show {
    opacity: 1;
}

.copy-address:hover::after,
.copy-address:focus-visible::after {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

.copy-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--surface-strong);
    color: var(--accent);
    font-weight: 700;
    padding: 0.75rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    box-shadow: 0 12px 24px rgba(57, 217, 159, 0.25);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 999;
}

.copy-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

.venue-thumb {
    display: inline-block;
    width: 222px;
    height: 222px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--border);
    vertical-align: middle;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s ease;
}

.venue-thumb:hover {
    transform: scale(1.04);
}
</file>

