/* Bandeau défilant des partenaires */
.partners-banner {
    --tile-w: 170px;
    --tile-h: 84px;
    --gap: 1.5rem;

    width: 100%;
    margin: 2.5rem 0 0;
    padding: 1.25rem 0 0.5rem;
    background: rgba(12, 16, 30, 0.7);
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    overflow: hidden;
}

.partners-title {
    margin: 0 0 0.5rem;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted, #aab6cf);
}

.partners-marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Marge haute : place pour le zoom. Marge basse : place pour le nom qui descend. */
    padding: 1.1rem 0 3.4rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
}

.partners-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-around;
    min-width: 100%;
    gap: var(--gap);
    padding-right: var(--gap); /* = gap, pour une boucle sans à-coup */
    /* La durée est recalculée par partners.js pour une vitesse constante en px/s */
    animation: partners-scroll var(--partners-duration, 120s) linear infinite;
}

/* Tuile sombre, dans le style du site */
.partner-tile {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tile-w);
    height: var(--tile-h);
    padding: 0.6rem 0.9rem;
    background: var(--surface-strong, rgba(20, 27, 44, 0.96));
    border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    border-radius: 14px;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.35s ease;
}

/* Variante claire, uniquement si un logo n'est lisible que sur fond clair */
.partner-tile.is-light {
    background: #eef1f6;
}

.partner-tile img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
}

/* Nom : part de derrière le logo et glisse vers le bas (la position suit la tuile) */
.partner-name {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    white-space: nowrap;
    font-size: 0.85rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--text, #eff3f8);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.3s ease;
}

.partner-tile.is-active,
a.partner-tile:focus-visible {
    z-index: 2;
    transform: scale(1.08);
    border-color: var(--accent, #39d99f);
}

.partner-tile.is-active .partner-name,
a.partner-tile:focus-visible .partner-name {
    opacity: 1;
    transform: translate(-50%, calc(-50% + var(--tile-h) / 2 + 1.05rem));
}

/* Survol souris uniquement (sur tactile, c'est la classe .is-active posée par le JS) */
@media (hover: hover) {
    .partner-tile:hover {
        z-index: 2;
        transform: scale(1.08);
        border-color: var(--accent, #39d99f);
    }
    .partner-tile:hover .partner-name {
        opacity: 1;
        transform: translate(-50%, calc(-50% + var(--tile-h) / 2 + 1.05rem));
    }
}

a.partner-tile:focus-visible {
    outline: 2px solid var(--accent, #39d99f);
    outline-offset: 3px;
}

@keyframes partners-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-100%); }
}

/* Mobile */
@media (max-width: 660px) {
    .partners-banner { --tile-w: 128px; --tile-h: 64px; --gap: 1rem; margin-top: 2rem; }
    .partner-tile { padding: 0.45rem 0.7rem; border-radius: 12px; }
    .partner-name { font-size: 0.8rem; }
    .partners-marquee { padding-bottom: 3rem; }
}

@media (max-width: 380px) {
    .partners-banner { --tile-w: 112px; --tile-h: 56px; }
}

/* Mouvement réduit : plus de défilement, les logos passent à la ligne */
@media (prefers-reduced-motion: reduce) {
    .partners-marquee {
        -webkit-mask-image: none;
                mask-image: none;
    }
    .partners-group { animation: none; flex-wrap: wrap; justify-content: center; row-gap: 3rem; }
    .partners-group[aria-hidden="true"] { display: none; }
    .partners-group .partner-tile:nth-child(n + 7) { display: none; } /* un seul passage de la liste */
}
